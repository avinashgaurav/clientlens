# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter: gateway for many models (Llama, DeepSeek, GPT, Gemini, Claude, etc.)
# Get key: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# App attribution (optional, shown on openrouter.ai/activity)
OPENROUTER_REFERER=https://clientlens.example.com
OPENROUTER_TITLE=ClientLens

# Google Gemini: chat and KB embeddings (Ask-KB search by meaning).
# On a key created today only gemini-3.6-flash works; see docs/configuration.md.
GEMINI_API_KEY=

# Optional: models callers may use on the server's keys, comma-separated.
# Empty means the defaults in api/routes/llm.py (the models the extension offers).
# Gemini has its own fixed list in llm.py and no override.
ALLOWED_MODELS_ANTHROPIC=
ALLOWED_MODELS_GROQ=
ALLOWED_MODELS_OPENROUTER=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Deepgram STT: key stays server-side, never in the extension bundle.
# Project ID: https://console.deepgram.com → Settings → Projects
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Google OAuth (for Slides/Docs API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho CRM OAuth: client_secret stays server-side, never in the extension bundle.
# The extension proxies all token exchanges through /api/v1/zoho/{exchange,refresh}.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# App
BACKEND_URL=https://your-backend.railway.app
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000
JWT_SECRET=change-me-in-production
